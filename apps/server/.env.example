# --- required in production ---
JWT_SECRET=                      # 32+ random characters (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
NODE_ENV=production

# --- optional ---
PORT=3001
JWT_EXPIRES_IN=24h
DATABASE_PATH=./data/app.db      # point at the old backend's data/app.db to keep existing users
ALLOWED_ORIGINS=https://heatmap-matrix-frontend.vercel.app,https://printersbackend.org,https://www.printersbackend.org
DATA_PROVIDERS=external,yahoo    # tried in order, one provider per response
EXTERNAL_DATA_URL=http://127.0.0.1:8000
EXTERNAL_API_KEY=
TRUST_PROXY=1                    # hops of reverse proxy in front (Cloudflare/Caddy)
